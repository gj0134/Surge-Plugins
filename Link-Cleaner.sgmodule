#!name=网页链接净化
#!desc=删除知乎、微博、B站网页链接中的 utm_*、spm、vd_source 和常见分享追踪参数；保留令牌、签名及业务参数，必须开启 MITM 主开关
#!system=mac
#!category=隐私保护

[Script]
网页链接净化 = type=http-request,pattern=^https?:\/\/(?:www\.zhihu\.com|(?:www\.)?weibo\.com|m\.weibo\.cn|(?:www\.|m\.|space\.)?bilibili\.com)(?:\/|\?|$),timeout=5,script-path=https://raw.githubusercontent.com/gj0134/Surge-Plugins/d3397482ed3101c41e6f1fb04fc5fcd1312eea15/Link-Cleaner.js

[MITM]
hostname = %APPEND% www.zhihu.com, weibo.com, www.weibo.com, m.weibo.cn, bilibili.com, www.bilibili.com, m.bilibili.com, space.bilibili.com
