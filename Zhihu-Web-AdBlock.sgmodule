#!name=知乎网页净化
#!desc=屏蔽知乎网页端信息流与侧栏广告，并隐藏顶部 AI Works、故事入口
#!system=mac
#!category=去广告

[Rule]
# 知乎广告曝光/点击统计
DOMAIN,sugar.zhihu.com,REJECT
DOMAIN,zhihu-web-analytics.zhihu.com,REJECT
URL-REGEX,^https:\/\/www\.zhihu\.com\/commercial_api\/,REJECT

[Script]
# 给网页注入隐藏规则；非 HTML 响应会直接放行
知乎网页界面净化 = type=http-response,pattern=^https:\/\/www\.zhihu\.com\/(?!api\/),requires-body=true,max-size=4194304,timeout=5,script-path=https://raw.githubusercontent.com/gj0134/Surge-Plugins/main/Zhihu-Web-AdBlock.js

# 清理首页信息流、搜索结果和问题回答列表中的广告对象
知乎网页数据净化 = type=http-response,pattern=^https:\/\/www\.zhihu\.com\/api\/(?:v3\/feed\/topstory\/recommend|v4\/search_v3|v4\/questions\/\d+\/(?:answers|feeds))(?:\?|$),requires-body=true,max-size=2097152,timeout=5,script-path=https://raw.githubusercontent.com/gj0134/Surge-Plugins/main/Zhihu-Web-AdBlock.js

[MITM]
hostname = %APPEND% www.zhihu.com
