#!name=微博网页净化
#!desc=过滤微博网页信息流、个人主页和热搜广告，并尽力阻断个人主页访问行为上报；必须开启 MITM 主开关
#!system=mac
#!category=去广告

[Rule]
# HAR 中的广告提示接口
URL-REGEX,^https:\/\/www\.weibo\.com\/ajax\/feed\/getTipsAd(?:\?|$),REJECT

# 页面行为、阅读时长与 RUM 遥测；不拦截主页资料和微博内容接口
URL-REGEX,^https:\/\/(?:www\.)?weibo\.com\/ajax\/log\/(?:action|read)(?:\?|$),REJECT
DOMAIN,rum.h5.weibo.cn,REJECT

[Script]
# 对 HAR 已确认的信息流、主页微博和热搜结构做响应过滤
微博信息流与热搜广告过滤 = type=http-response,pattern=^https:\/\/www\.weibo\.com\/ajax\/(?:feed|statuses|search|side)\/[^?]+(?:\?|$),requires-body=true,max-size=2097152,timeout=5,script-path=https://raw.githubusercontent.com/gj0134/Surge-Plugins/db64897/Weibo-Web-AdBlock.js

[MITM]
hostname = %APPEND% www.weibo.com, weibo.com
